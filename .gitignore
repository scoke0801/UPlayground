# Visual Studio 2015 user specific files
.vs/


# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.vsconfig
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
*/SourceArt/**/*.png
*/SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/*/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
*/!Build/*/
*/Build/*/**
*/!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*/*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/*/Intermediate/*

# Cache files for the editor to use
*/DerivedDataCache/*

ExternalAssets/*
*/Animations/*
Content/*
**/Model
**/.env
**/.idea
**/.sentry-native
/Content
/DerivedDataCache

# Script folders and Korean filenames
Script/
**/Script/
**/*클래스*
**/*다이어그램*
**/*한글*
**/*[ㄱ-ㅎ]*
**/*[가-힣]*

# Exclude all PNG files in script directories
Script/**/*.png
**/Script/**/*.png

# Temporary workaround for Unicode filename issues
**/[!A-Za-z0-9_./-]*


**/*.md
# Track project planning documents
!/Docs/todo/*.md
!/CLAUDE.md
!/PROJECT_OVERVIEW.md

