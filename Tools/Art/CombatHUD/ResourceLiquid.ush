// Custom UI material expression. UV spans the complete authored 144px frame.
float2 p = (UV - 0.5) / 0.337;
float radius = length(p);
float aa = max(fwidth(radius), 0.008);
float mask = 1.0 - smoothstep(1.0-aa, 1.0+aa, radius);
float t = LiquidTime * WaveSpeed + Phase;
float amplitude = WaveAmplitude * (1.0 + Agitation * 3.0);
// Fade displacement at the endpoints: empty is empty and full stays full.
float edge = saturate(Fill * 18.0) * saturate((1.0-Fill) * 18.0);
float wave = sin(p.x*5.2+t*2.2)*0.65 + sin(p.x*9.1-t*1.7)*0.35;
float surface = 1.0-2.0*Fill + edge*amplitude*(wave + Agitation*p.x*sin(t*3.1));
float depth = p.y-surface;
float liquid = smoothstep(-aa,aa,depth);
if (Fill <= 0.0) liquid=0.0;
if (Fill >= 1.0) liquid=1.0;
float dome = sqrt(saturate(1.0-dot(p,p)));
// Broad, low-contrast currents: no bright cellular/lava pattern at HUD scale.
float flow = sin(p.x*3.8+p.y*2.6+t*0.65+0.6*sin(p.y*3.2-t*0.48));
float drift = sin(p.x*6.0-p.y*3.5-t*0.8+flow*0.65);
float transmission = exp(-dot((p-float2(-0.28,0.35))*float2(1.8,1.5),(p-float2(-0.28,0.35))*float2(1.8,1.5)));
float3 body = LiquidColor * (0.16+0.56*dome+0.22*transmission+FlowStrength*(0.095*flow+0.045*drift));
// A softly lit meniscus, with a fine moving rim and a translucent band beneath it.
float meniscus = exp(-abs(depth)*60.0)*edge;
float surfaceBand = exp(-pow((depth-0.032)*22.0,2.0))*edge;
float surfaceLight = 0.35+0.65*saturate(1.0-abs(p.x+0.25));
body += LiquidColor*surfaceBand*0.20;
body += lerp(LiquidColor,float3(1.0,0.78,0.58),0.3)*meniscus*surfaceLight*0.24;
float3 color = lerp(float3(0.008,0.009,0.013)*(0.55+0.45*dome),body,liquid);
// Restrained elongated reflections make the vessel read as polished glass.
float2 highlight = (p-float2(-0.37,-0.52))*float2(7.0,16.0);
float glint = exp(-dot(highlight,highlight));
float2 softHighlight = (p-float2(-0.40,-0.48))*float2(4.5,8.0);
color += float3(0.72,0.79,0.88)*(0.13*glint+0.035*exp(-dot(softHighlight,softHighlight)));
float rim = exp(-pow((radius-0.93)*35.0,2.0));
color += float3(0.18,0.23,0.30)*rim*saturate(-p.x-p.y)*0.18;
color *= 0.35+0.65*smoothstep(0.0,0.30,1.0-radius);
// A subtle vignette behind the in-orb numerals maintains contrast at every fill.
color *= 1.0-0.26*exp(-pow(p.y*7.0,2.0))*saturate(1.0-p.x*p.x);
return float4(color,mask);
